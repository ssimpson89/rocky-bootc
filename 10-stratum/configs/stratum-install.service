[Unit]
Description=Install the shipped Stratum binary as the live binary on first boot
ConditionPathExists=!/usr/local/bin/stratum
Before=stratum.service

[Service]
Type=oneshot
ExecStart=/usr/bin/install -D -m 0755 /usr/libexec/stratum/stratum /usr/local/bin/stratum

[Install]
WantedBy=multi-user.target
